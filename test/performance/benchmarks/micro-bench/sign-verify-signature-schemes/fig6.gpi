#!/usr/bin/env gnuplot
load 'style.gpi'

# Override the eps terminal from style.gpi with pdfcairo so we emit a PDF.
set terminal pdfcairo enhanced color font "Helvetica, 12" size 7in, 6in
set output "fig6.pdf"

set size 1, 1
set multiplot layout 2,1 rowsfirst margins 0.16,0.95,0.12,0.95 spacing 0  # two rows, 1 column; the two graphs touch
#set multiplot layout 2,1 rowsfirst spacing 0  # two rows, 1 column; the two graphs touch


###########################################################
# Draw shared layout
###########################################################

set grid ytics
set tics nomirror

set xrange[-1:1050]

set logscale y
set ytics ( \
        "0.001"   0.001, \
        "0.01"   0.01, \
        "0.1"   0.1, \
        "1"     1, \
        "10"   10, \
        "100"  100, \
        "1000"  1000, \
        )

# Draw a single shared ylabel
set label 1 "Time (ms) (log scale)" at screen 0.02,0.5 center rotate by 90

set key font ",12" outside center top horizontal maxrows 2 Left reverse

###########################################################
# Top plot
###########################################################
set xtics ( \
        ""     0, \
        ""   200, \
        ""   400, \
        ""   600, \
        ""   800, \
        ""  1000, \
        )

set ylabel "Sign"

# - convert nanoseconds to milliseconds (1,000,000 ns = 1 ms)
plot "fig6.dat" \
        using 1:($2/1e6) with  linespoints linestyle 1 linewidth 4 title 'RSA', \
    ""  using 1:($4/1e6) with  linespoints linestyle 2 linewidth 4 title 'Ed25519', \
    ""  using 1:($6/1e6) with  linespoints linestyle 3 linewidth 4 title 'BGLS03', \
    ""  using 1:($8/1e6) with  linespoints linestyle 4 linewidth 4 title 'B03', \
    ""  using 1:($10/1e6) with linespoints linestyle 5 linewidth 4 title 'BGOY07'


###########################################################
# Bottom plot
###########################################################
unset key
set ylabel "Verify"
set xlabel "Number of Signatures" 
set xtics ( \
        "0"     0, \
        "200"   200, \
        "400"   400, \
        "600"   600, \
        "800"   800, \
        "1000"  1000, \
        )
# - convert nanoseconds to milliseconds (1,000,000 ns = 1 ms)
plot "fig6.dat" \
        using 1:($3/1e6) with  linespoints linestyle 1 linewidth 4 title "RSA", \
    ""  using 1:($5/1e6) with  linespoints linestyle 2 linewidth 4 title "Ed25519", \
    ""  using 1:($7/1e6) with  linespoints linestyle 3 linewidth 4 title "BGLS03", \
    ""  using 1:($9/1e6) with  linespoints linestyle 4 linewidth 4 title "B03", \
    ""  using 1:($11/1e6) with linespoints linestyle 5 linewidth 4 title "BGOY07"


unset multiplot
